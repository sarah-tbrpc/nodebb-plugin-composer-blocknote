{
	"id": "nodebb-plugin-composer-blocknote",
	"name": "BlockNote Composer",
	"description": "A modern WYSIWYG block-based composer for NodeBB using BlockNote.",
	"version": "0.2.0",
	"library": "./library.js",
	"hooks": [
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
		{ "hook": "filter:composer.build", "method": "build" },
		{ "hook": "filter:topic.post", "method": "sanitize" },
		{ "hook": "filter:topic.reply", "method": "sanitize" },
		{ "hook": "filter:post.edit", "method": "sanitize" }
	],
	"scripts": [
		"public/lib/composer.js"
	],
	"acpScripts": [
		"public/lib/admin.js"
	],
	"css": [
		"static/dist/composer.bundle.css"
	],
	"staticDirs": {
		"static": "./static"
	},
	"templates": "./templates",
	"languages": "./languages",
	"nbbpm": {
		"compatibility": "^3.2.0"
	}
}
